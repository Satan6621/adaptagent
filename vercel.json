{
  "builds": [
    { "src": "api/asgi.py", "use": "@vercel/python", "config": { "includeFiles": "adaptagent/**" } },
    { "src": "public/index.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api(.*)", "dest": "api/asgi.py" },
    { "src": "/(.*)", "dest": "public/index.html" }
  ]
}
